# Скопируйте в .env и задайте значения: cp deploy/.env.example deploy/.env

NODE_ENV=production
# user-api 3101, auth-api 3102 (в контейнере оба поднимаются scripts/start-apis.sh)
MONGODB_URI=mongodb://mongodb:27017/bank
JWT_SECRET=change-me-in-production
MMS3_API_URL=
MMS3_API_KEY=
MMS3_TENANT_ID=tnt_default
CORS_ORIGIN=

# Домены для UI (подставляются в бандл при сборке образа)
# user-ui: куда редиректить на форму входа
VITE_AUTH_UI_URL=https://auth.example.com
# auth-ui: куда редиректить после входа; URL auth-api для запросов
VITE_USER_UI_URL=https://app.example.com
VITE_AUTH_API_URL=https://auth-api.example.com
