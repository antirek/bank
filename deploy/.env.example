# Скопируйте в .env и задайте значения: cp deploy/.env.example deploy/.env

NODE_ENV=production
# user-api 3101, auth-api 3102 (в контейнере оба поднимаются scripts/start-apis.sh)
MONGODB_URI=mongodb://mongodb:27017/bank
JWT_SECRET=change-me-in-production
MMS3_API_URL=
MMS3_API_KEY=
MMS3_TENANT_ID=tnt_default
CORS_ORIGIN=

# Домены для UI задаются рядом с Vite: packages-ui/user-ui/.env.production и packages-ui/auth-ui/.env.production
# (скопируйте из .env.production.example в каждом пакете)
