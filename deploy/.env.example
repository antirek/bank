# Скопируйте в .env и задайте значения: cp deploy/.env.example deploy/.env

NODE_ENV=production
# user-api 3101, auth-api 3102 (в контейнере оба поднимаются scripts/start-apis.sh)
MONGODB_URI=mongodb://mongodb:27017/bank
# Один и тот же секрет в auth-api и user-api (иначе токен после входа даст 401 Invalid token)
JWT_SECRET=change-me-in-production
MMS3_API_URL=
MMS3_API_KEY=
MMS3_TENANT_ID=tnt_default
CORS_ORIGIN=

# user-api: user-ui читает GET /public-config.json (без пересборки)
# PUBLIC_AUTH_UI_URL=https://test5.services.mobilon.ru
# PUBLIC_USER_UI_URL=https://test4.services.mobilon.ru
# PUBLIC_WS_URL=wss://test4.services.mobilon.ru/ws
# PUBLIC_OWNER_APP_URL=https://test6.services.mobilon.ru

# auth-api: POST-login редиректы — GET /public-config.json (нужны те же PUBLIC_USER_UI_URL / PUBLIC_OWNER_APP_URL при необходимости)

# Локальная сборка Vite (опционально, если всё задаёте PUBLIC_* на API выше)
# packages-ui/user-ui/.env.production и т.д.

# Домены для UI (fallback при отсутствии PUBLIC_*): packages-ui/*/.env.production.example
# (скопируйте из .env.production.example в каждом пакете)
#
# Порт раздачи owner-pwa (Express owner-api), по умолчанию 3105
# OWNER_API_PORT=3105
#
# Runtime-конфиг для owner-pwa (GET /runtime-config.json с owner-api), без пересборки фронта
# OWNER_PUBLIC_URL=https://owner.example.com
# OWNER_AUTH_UI_URL=https://auth.example.com
# OWNER_API_BASE_URL=https://api.example.com/api
# OWNER_WS_URL=wss://ws.example.com/ws
# OWNER_APP_TITLE=Boqq — чаты
#
# Сборка Docker: deploy/env.build.example → deploy/.env.build, затем ./build.sh
