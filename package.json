{
  "name": "boqq",
  "version": "1.0.0",
  "private": true,
  "description": "Система общения бизнеса и клиентов",
  "workspaces": [
    "packages/*",
    "packages-ui/*",
    "packages-ui/shared/api-client",
    "packages-shared"
  ],
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm run start:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n user-api,user-ui,auth-api,auth-ui -c blue,green,yellow,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:auth-api\" \"npm run dev:auth-ui\"",
    "dev:backend": "npm run dev -w boqq-backend",
    "dev:frontend": "npm run dev -w boqq-frontend",
    "dev:auth-api": "npm run dev -w boqq-auth-api",
    "dev:auth-ui": "npm run dev -w boqq-auth-ui",
    "start:backend": "npm start -w boqq-backend",
    "start:auth-api": "npm start -w boqq-auth-api",
    "build:frontend": "npm run build -w boqq-frontend",
    "preview:frontend": "npm run preview -w boqq-frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
