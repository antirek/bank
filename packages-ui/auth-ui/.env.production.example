# Домены для production-сборки (Vite). Скопируйте в .env.production и задайте значения.
# auth-ui: URL auth-api для запросов (в prod часто пусто — тот же origin)
VITE_AUTH_API_URL=
# Fallback, если auth-api не отдаёт /public-config.json (см. PUBLIC_* в deploy/.env на auth-api)
VITE_USER_UI_URL=https://app.example.com
VITE_OWNER_APP_PUBLIC_URL=https://owner.example.com
