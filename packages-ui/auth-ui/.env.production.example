# Домены для production-сборки (Vite). Скопируйте в .env.production и задайте значения.
# auth-ui: куда редиректить после входа; URL auth-api для запросов
VITE_USER_UI_URL=https://app.example.com
# PWA владельца (поддомен): нужен в сборке auth-ui, чтобы разрешить ?return= на этот origin
VITE_OWNER_APP_PUBLIC_URL=https://owner.example.com
VITE_AUTH_API_URL=https://auth-api.example.com
