# Скопируйте в .env.development / .env.production и задайте значения.
# В production обязательны все переменные, которые проверяет assertOwnerAppConfig() в src/config.js

# Заголовок в шапке и в Web App Manifest (name)
# VITE_APP_TITLE=Boqq — чаты для бизнеса

# Короткое имя в манифесте (иконка на экране)
# VITE_PWA_SHORT_NAME=Boqq Чаты

# Описание PWA (манифест)
# VITE_PWA_DESCRIPTION=Чаты с клиентами

# Цвета манифеста / theme-color
# VITE_THEME_COLOR=#5c6bc0
# VITE_PWA_BACKGROUND_COLOR=#f0f2f8

# База user-api: в dev с прокси Vite — /api; на отдельном поддомене (Docker nginx) — https://api.example.com/api
VITE_API_BASE_URL=/api

# Публичный URL этого приложения (поддомен владельца), без слэша в конце.
# Docker compose: http://localhost:3105 (сервис owner-api, см. deploy/docker-compose.yml)
VITE_OWNER_APP_PUBLIC_URL=http://localhost:5175

# Страница входа (auth-ui), тот же JWT что у клиентского приложения
VITE_AUTH_UI_URL=http://localhost:5174

# WebSocket ws-server; в dev пусто = ws(s) на текущий хост + путь /ws (прокси)
# В production при вынесенном API обычно нужен полный wss://…
# VITE_WS_URL=wss://ws.example.com/ws
