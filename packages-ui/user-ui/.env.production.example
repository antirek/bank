# Домены для production-сборки (Vite). Скопируйте в .env.production и задайте значения.
# Обязательно отдельный origin от этого приложения (не тот же URL, что и клиентский сайт).
VITE_AUTH_UI_URL=https://auth.example.com
# Если user-api не на том же origin, что и эта SPA (нет прокси /api), укажите полный URL API:
# VITE_API_BASE_URL=https://api.example.com/api
